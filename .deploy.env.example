# 复制为 .deploy.env 后填写（.deploy.env 不会进版本库）
# 建议使用非 root 部署账号（如 deploy），并限制其 sudo/写权限范围
WEB_REMOTE=deploy@your-server-hostname
WEB_HOST=your-server-hostname
WEB_DIR=/var/www/ww
WEB_SITE_URL=your-name.devs.surf

# 可选：先演练不同步
# ./scripts/deploy.sh --dry-run

# 可选：rsync --delete 的排除项（空格分隔），默认 "study/ stats.json"
# 前者防误删同 root 下的 Study Copilot，后者是服务器生成的访问人次文件
# RSYNC_EXCLUDE="study/ stats.json"
